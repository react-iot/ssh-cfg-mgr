{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Cfg Mgr",
  "version": "0.1.0",
  "identifier": "com.reactiot.sshcfgmgr",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SSH Cfg Mgr",
        "width": 1040,
        "height": 680,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "license": "Apache-2.0",
    "shortDescription": "Manage ~/.ssh/config and SSH keys",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
